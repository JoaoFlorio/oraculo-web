generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  plan      String    @default("free")
  active    Boolean   @default(true)
  expiresAt DateTime?
  phone     String?
  role      String    @default("client")   // client | staff | admin
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions        Session[]
  resetToken      String?   @unique
  resetTokenExpAt DateTime?
  metadata        Json?     @default("{}")
}

// Vendas reais (Greenn) — fonte de verdade do faturamento. Uma linha por
// pagamento aprovado (nova compra ou renovação). Nada de dado inventado.
model Sale {
  id        String    @id @default(cuid())
  email     String
  name      String?
  phone     String?
  plan      String
  amount    Float                              // valor pago em reais (preço do plano)
  status    String    @default("paid")         // paid | refunded | canceled
  greennId  String?   @map("greenn_id")
  paidAt    DateTime  @default(now()) @map("paid_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([paidAt])
  @@index([status])
  @@map("sales")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Licenças da extensão Chrome — gerenciadas pelo Prisma para garantir persistência
model License {
  key        String   @id
  email      String
  plan       String
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  active     Boolean  @default(true)
  deviceIds  String[] @default([]) @map("device_ids")
  maxDevices Int      @default(2) @map("max_devices")

  @@map("licenses")
}

// Log imutável de operações de licença — INSERT-only, nunca DELETE/UPDATE.
// Serve como fonte de verdade para reconstruir `licenses` após reset do banco.
// event_type: 'create' | 'deactivate' | 'renew' | 'register_device'
// payload: estado relevante no momento do evento (JSON livre por tipo)
model LicenseEvent {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at")
  eventType   String   @map("event_type")
  licenseKey  String   @map("license_key")
  payload     Json     @default("{}")

  @@index([licenseKey], name: "idx_license_events_key")
  @@index([eventType],  name: "idx_license_events_type")
  @@map("license_events")
}
